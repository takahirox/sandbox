{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-persistent-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-06-11",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://takahirox.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandbox-persistent-counter",
      "migrations_dir": "migrations"
    }
  ]
}
