{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-persistent-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-06-11",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" },
      { "name": "RPS", "class_name": "RockPaperScissors" },
      { "name": "BINGO", "class_name": "Bingo" },
      { "name": "PONG", "class_name": "PongSignaling" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] },
    { "tag": "v2", "new_sqlite_classes": ["RockPaperScissors"] },
    { "tag": "v3", "new_sqlite_classes": ["Bingo"] },
    { "tag": "v4", "new_sqlite_classes": ["PongSignaling"] }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://takahirox.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandbox-persistent-counter",
      "migrations_dir": "migrations"
    }
  ]
}
